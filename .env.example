# Copy to .env.local for local development. `npm run db:setup` fills in both database URLs.

# Runtime connection as the restricted role lasan_pro_app (row-level security applies to it).
# Local: the Postgres service's public proxy host. On Railway: the private host, e.g.
#   postgresql://lasan_pro_app:<password>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/lasan_pro
DATABASE_URL=postgresql://lasan_pro_app:password@host.proxy.rlwy.net:12345/lasan_pro
# Owner connection used only by `npm run db:migrate`. Never give this to the running app.
DATABASE_ADMIN_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/lasan_pro
# Optional: force TLS on/off. Auto-detected when omitted.
# DATABASE_SSL=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=7d

# Decides what "today" is for attendance. Keep both the same.
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Photo storage (Cloudinary). Without these, photos are kept inline in the database (local development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lasan-people-pro
# Check-in photos are deleted after this many days.
PUNCH_PHOTO_RETENTION_DAYS=7
